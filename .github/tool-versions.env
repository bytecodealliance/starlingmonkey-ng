# The tool versions CI and releases install. The setup action adds them to the job's environment,
# and `actions/setup/install-tool.sh` installs the version given here, checking the digest it
# lists for it. A new release changes nothing until these are bumped.
JUST_VERSION=1.58.0
WASI_SDK_VERSION=34
# The wasmtime CLI the wasm tests run under, and the wasm-tools CLI `scripts/build-runtime.sh`
# wraps the runtime with, each at the version of the crates `componentize/Cargo.lock` holds.
WASMTIME_VERSION=50.0.0
WASM_TOOLS_VERSION=1.262.0
# The beta toolchain wasm32-wasip3 builds use.
STARLING_BETA=beta-2026-10-18
NODE_VERSION=24.21.0
