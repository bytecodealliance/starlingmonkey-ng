package test:async-export;

// The async-export world.
//
// Two exported interfaces in ONE component, so a single componentization proves
// that sync and async exports coexist on the same runtime:
//
//   - `simple-export.foo` is a plain sync function that lowers its result
//     synchronously through `export_call`, as the sync suite does.
//   - `simple-async-export.foo` is `async`, so the generated `export!` glue
//     routes it through `export_call_async`: the runtime calls the JS `async
//     function`, drives a per-call event loop until the returned promise settles
//     (the guest awaits a real `setTimeout`, forcing a genuine suspension and a
//     timer turn), then lowers the result via `task-return`.
//
// Both return `v + 3`, so the host asserts `42 -> 45` on each. Driving the
// async one to 45 exercises loop-creation, the suspension/resume, the
// promise-settled check, the result lowering, and per-invocation attribution.

interface simple-export {
  foo: func(v: u32) -> u32;

  // Calls `setTimeout` and returns the message of the `TypeError` it throws,
  // since a sync export runs without an event loop.
  timer-message: func() -> string;

  // Calls `fetch`, whose promise rejects without an event loop, and returns
  // the rejection's message a previous call recorded, or "none".
  fetch-message: func() -> string;

  // Queues a microtask that increments a counter, and returns the counter's
  // value from before the call. The microtask runs before the call returns, so
  // each call returns the number of calls before it.
  drained-microtasks: func() -> u32;
}

interface simple-async-export {
  foo: async func(v: u32) -> u32;

  // A deadlocking async export: it `await`s a promise that never resolves and
  // schedules no timer/loop work, so the per-call event loop goes idle while the
  // returned promise is still pending. The driver must surface this as a clean
  // trap (host-observable `Err`), not a panic that aborts the process.
  hang: async func() -> u32;

  // An async export that delivers its result but leaves a perpetual
  // `setInterval` running. The result settles normally (so `task-return` lowers
  // it), but the per-call event loop stays non-idle forever. The interval is not
  // a canonical-ABI waitable, so it must NOT gate the export's subtask: the
  // driver must complete the call (returning the result) and abandon the timer,
  // never wait on it (which would hang the host's `task.block`).
  perpetual: async func(v: u32) -> u32;

  // Rejects with an `Error` holding `message` after a timer turn. The rejection
  // becomes the `err` string, and is not reported as an unhandled rejection.
  fail: async func(message: string) -> result<u32, string>;

  // Waits `ms` milliseconds on a timer, then returns how many
  // `drained-microtasks` microtasks ran while it waited.
  parked: async func(ms: u32) -> u32;
}

world async-export {
  export simple-export;
  export simple-async-export;
}
